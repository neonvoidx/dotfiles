Include ssh_configs/config
Include ossh_configs/*.ossh
AddKeysToAgent yes

Host github.com neonvoidx-github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes

Host work-github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_jacobrreed
    IdentitiesOnly yes

Host oci*.private.devops.scmservice.*.oci.oracleiaas.com
   User jrreed@bmc_operator_access
   IdentityAgent /Users/jrreed/.ssh/scm-agent.sock

Include config-scm

# Yubikey
PKCS11Provider /Library/OpenSC/lib/opensc-pkcs11.so

####################################
# Global defaults
####################################
 Host *

    ServerAliveInterval 120
    ServerAliveCountMax 3
    TCPKeepAlive yes
    HashKnownHosts yes
    # per https://jira.oci.oraclecorp.com/browse/SESVC-2795 (and https://jira.oci.oraclecorp.com/browse/LGLTVM-1484) changed from 'no' to 'ask'
    StrictHostKeyChecking ask
    Protocol 2
    ForwardAgent no
    ForwardX11 no
    ForwardX11Trusted no
    # Temporary workaround for an issue starting around 2019-12-03 where ssh clients won't initiate any traffic.
    ConnectTimeout 20
    # Specifies a pattern-list of unknown options to be ignored if they are encountered in configuration parsing, this is required for older SSH Clent that don't have HostkeyAlgorithms and PubkeyAcceptedAlgorithms specifically for ssh clients older than 8.6
    IgnoreUnknown HostkeyAlgorithms,PubkeyAcceptedAlgorithms
    # Add ssh-rsa as hostkey and pubkey algorithm as bastion sshd servers and OCI bitbucket is configured to use this as server algorithm.
    HostkeyAlgorithms +ssh-rsa,ssh-rsa-cert-v01@openssh.com
    PubkeyAcceptedAlgorithms +ssh-rsa,ssh-rsa-cert-v01@openssh.com
####################################

####################################
### TIW - US - Tacoma (OC5)
####################################
# Region build. When this ONSR is airgapped/disconnected, access will be restricted.
Host *.ad1.us-tacoma-1 !bastion*.oraclerealm5.com
    PermitLocalCommand yes
    ProxyCommand bash -c 'ssh $(ps -o args= $(ps -o ppid= $$) | grep -o -- " -v[v]*") -W %h:%p bastion-ad1.rb.us-tacoma-1.oci.oraclerealm5.com 2> /dev/null'
Host *bastion.us-tacoma-1.oci.oraclerealm5.com
    ProxyCommand nc -v -X 5 -x 10.144.158.116:1080 %h %p


## bitbucket
Host bitbucket.oci.oraclecorp.com
    IdentityFile ~/.ssh/id_ed25519_jacobrreed
    HostkeyAlgorithms +ssh-rsa
    PubkeyAcceptedAlgorithms +ssh-rsa
