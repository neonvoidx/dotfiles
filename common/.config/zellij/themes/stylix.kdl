themes {
  default {
    exit_code_error {
      background "#212337"
      base "#f16c75"
      emphasis_0 "#f1fc79"
      emphasis_1 "#212337"
      emphasis_2 "#212337"
      emphasis_3 "#212337"
    }
    exit_code_success {
      background "#212337"
      base "#37f499"
      emphasis_0 "#04d1f9"
      emphasis_1 "#323449"
      emphasis_2 "#f265b5"
      emphasis_3 "#39ddfd"
    }
    frame_highlight {
      background "#212337"
      base "#f16c75"
      emphasis_0 "#f265b5"
      emphasis_1 "#f7c67f"
      emphasis_2 "#f7c67f"
      emphasis_3 "#f7c67f"
    }
